<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_product_template_attribute_line" model="ir.actions.act_window">
        <field name="name">Product Template Attribute Lines</field>
        <field name="res_model">product.template.attribute.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field
            name="help"
        >Manage the attributes and values associated with product templates.</field>
    </record>

    <record id="menu_product_template_attribute_line" model="ir.ui.menu">
        <field name="name">Product Template Attribute Lines</field>
        <field name="parent_id" ref="sale.prod_config_main" />
        <field name="sequence">10</field>
        <field name="action" ref="action_product_template_attribute_line" />
    </record>

    <record id="product_template_attribute_line_view_tree_override" model="ir.ui.view">
        <field name="name">product.template.attribute.line.tree.override</field>
        <field name="model">product.template.attribute.line</field>
        <field
            name="inherit_id"
            ref="product.product_template_attribute_line_view_tree"
        />
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="create">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
